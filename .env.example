# Database (PostgreSQL)
DATABASE_URL="postgresql://plantcare:plantcare@localhost:5433/plantcare?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret-here"

# OAuth — add keys to enable each provider on login/register
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Instagram Basic Display: https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/instagram
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Plant image analysis — set ANALYSIS_PROVIDER to "primary" or "fallback"
ANALYSIS_PROVIDER="primary"
ANALYSIS_PRIMARY_KEY=""
ANALYSIS_FALLBACK_KEY=""

# Cloudinary file upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="plantcare"

# App
NODE_ENV="development"
