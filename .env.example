# Database (PostgreSQL)
DATABASE_URL="postgresql://plantcare:plantcare@localhost:5433/plantcare?schema=public"
POSTGRES_PRISMA_URL="postgresql://plantcare:plantcare@localhost:5433/plantcare?schema=public"
DATABASE_URL_UNPOOLED="postgresql://plantcare:plantcare@localhost:5433/plantcare?schema=public"
DATABASE_URL_UNPOOLED="postgresql://plantcare:plantcare@localhost:5433/plantcare?schema=public"
POSTGRES_PRISMA_URL="postgresql://plantcare:plantcare@localhost:5433/plantcare?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret-here"

# Vercel production (set in Vercel → Settings → Environment Variables)
# NEXTAUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_SECRET="same-random-secret-in-production"
# SETUP_SECRET="one-time-secret-to-call-/api/setup/bootstrap"
# DATABASE_URL comes from Vercel Postgres / Neon / Supabase integration

# OAuth — add keys to enable each provider on login/register
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Instagram Basic Display: https://developers.facebook.com/apps/
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/instagram
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Plant image analysis — provider: primary | fallback | plantnet | hybrid
# hybrid = PlantNet species ID + vision LLM for disease/pest (recommended on Vercel)
ANALYSIS_PROVIDER="hybrid"
ANALYSIS_PRIMARY_KEY=""
ANALYSIS_FALLBACK_KEY=""
# Free Gemini key for disease diagnosis: https://aistudio.google.com/apikey
# GEMINI_API_KEY=""
# Free tier: 500/day — https://my.plantnet.org/account/settings
PLANTNET_API_KEY=""
PLANTNET_PROJECT="all"

# Cloudinary file upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="plantcare"

# App
NODE_ENV="development"

# Weather (optional) — live watering schedules use Open-Meteo (no API key required).
# Set city + country in user profile for geocoding and 7-day forecast.

# Care notifications (optional) — Web Push when app is closed
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
# CRON_SECRET="random-secret-for-vercel-cron"
