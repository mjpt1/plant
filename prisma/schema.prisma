generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  EXPERT
  ADMIN
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ReportTargetType {
  POST
  COMMENT
  QUESTION
  ANSWER
  USER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  username      String    @unique
  password      String?
  avatar        String?
  bio           String?
  country       String?
  city          String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  plants          Plant[]
  scanHistory     ScanHistory[]
  posts           Post[]
  comments        Comment[]
  questions       Question[]
  answers         Answer[]
  careReminders       CareReminder[]
  pushSubscriptions   PushSubscription[]
  likes               Like[]
  followers           Follow[]       @relation("Following")
  following           Follow[]       @relation("Followers")
  votes               Vote[]
  reportsCreated      Report[]       @relation("ReportsCreated")
  reportsReviewed     Report[]       @relation("ReportsReviewed")
  catalogAdded        PlantCatalog[] @relation("CatalogContributor")
  diagnosisFeedback   DiagnosisFeedback[]
  careOutcomes        CareOutcome[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Plant {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogId        String?
  catalog          PlantCatalog?  @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  nameEn           String
  nameFa           String
  scientificName   String?
  imageUrl         String?
  healthStatus     String         @default("healthy")
  environment      String         @default("indoor")
  notes            String?        @db.Text
  careGuide        Json?
  carePlan         Json?
  lastWateredAt    DateTime?
  lastFertilizedAt DateTime?
  acquiredAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  scanHistory       ScanHistory[]
  careReminders     CareReminder[]
  careOutcomes      CareOutcome[]

  @@index([userId])
}

model PlantCatalog {
  id                  String   @id @default(cuid())
  externalId          String   @unique
  slug                String   @unique
  nameEn              String
  nameFa              String
  scientificName      String?
  category            String
  categoryFa          String
  description         String?  @db.Text
  sunRequirement      String?
  waterRequirement    String?
  soilType            String?
  soilPh              String?
  difficulty          String?
  wateringGuide       String?  @db.Text
  lightGuide          String?  @db.Text
  fertilizerGuide     String?  @db.Text
  soilGuide           String?  @db.Text
  toxicity            String?
  isIndoor            Boolean  @default(false)
  isContainerFriendly Boolean  @default(false)
  usdaZoneMin         Int?
  usdaZoneMax         Int?
  imageUrl            String?
  source              String
  addedByUserId       String?
  addedBy             User?    @relation("CatalogContributor", fields: [addedByUserId], references: [id], onDelete: SetNull)
  isUserSubmitted     Boolean  @default(false)
  isApproved          Boolean  @default(true)
  rawData             Json?
  createdAt           DateTime @default(now())
  userPlants          Plant[]

  @@index([category])
  @@index([nameEn])
  @@index([nameFa])
  @@index([isIndoor])
}

model ScanHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantId       String?
  plant         Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
  imageUrl      String
  imageType     String?
  plantData     Json
  healthData    Json
  careData      Json
  treatmentData Json
  metaData      Json?
  createdAt     DateTime @default(now())
  diagnosisFeedback DiagnosisFeedback[]

  @@index([userId])
  @@index([createdAt])
}

model DiagnosisFeedback {
  id               String   @id @default(cuid())
  scanId           String
  scan             ScanHistory @relation(fields: [scanId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wasCorrect       Boolean
  correctedLabel   String?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  @@unique([scanId, userId])
  @@index([userId])
  @@index([wasCorrect])
}

model CareOutcome {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantId          String?
  plant            Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
  reminderId       String?
  type             String
  scheduledAt      DateTime
  completedAt      DateTime
  deltaDays        Int?
  weatherTemp      Float?
  weatherHumidity  Float?
  weatherRainMm    Float?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([plantId])
  @@index([type])
  @@index([completedAt])
}

model Post {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  imageUrl  String?
  isHidden  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
  likes     Like[]

  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
}

model Question {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  category  String
  tags      String[] @default([])
  solved    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  answers   Answer[]

  @@index([category])
  @@index([createdAt])
}

model Answer {
  id              String   @id @default(cuid())
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String   @db.Text
  isAccepted      Boolean  @default(false)
  isExpertVerified Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  votes           Vote[]

  @@index([questionId])
}

model Vote {
  id        String   @id @default(cuid())
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value     Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
}

model CareReminder {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plantId     String?
  plant       Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
  titleEn     String
  titleFa     String
  type        String
  scheduledAt DateTime
  completed   Boolean   @default(false)
  notifiedAt  DateTime?
  recurring   String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([scheduledAt])
  @@index([completed])
  @@index([notifiedAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  reporter     User             @relation("ReportsCreated", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType
  targetId     String
  reason       String
  details      String?          @db.Text
  status       ReportStatus     @default(PENDING)
  reviewedById String?
  reviewedBy   User?            @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}
